# Copy to `.env.local` for local development (never commit secrets).
# https://nextjs.org/docs/app/building-your-application/configuring/environment-variables

# Public variables (exposed to the browser) — prefix with NEXT_PUBLIC_
# NEXT_PUBLIC_API_BASE_URL=https://internal-server.0110100001110010.org/api/v1
# Google Analytics 4 measurement ID. Unset = no tag loads (the default locally,
# so dev traffic stays out of the property). Inlined at build time, so in Docker
# it must be passed as a build ARG, not a runtime env var — see Dockerfile.
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Google Places API (New) key, used for business address lookup during
# onboarding. This ships in the browser bundle, so restrict it in the Google
# Cloud console by HTTP referrer and to the Places API only. Unset = no address
# suggestions, and onboarding continues with the address as typed.
# Inlined at build time, so in Docker it must be passed as a build ARG — see Dockerfile.
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Server-only (not prefixed with NEXT_PUBLIC_)
# API_SECRET_KEY=
